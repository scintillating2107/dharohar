# Dharohar configuration. Copy to .env.local (development) or set in your hosting provider.
# Generate production secrets with:  npm run secrets

# --- Security (required in production) -------------------------------------------------
JWT_SECRET=
INTEGRATION_SERVICE_KEY=
# Ed25519 private key (base64 PKCS8 PEM) used to sign record certificates. Keep it stable and backed up.
CERT_SIGNING_KEY=

# --- Database ---------------------------------------------------------------------------
# PostgreSQL connection string. Leave empty to use the embedded PostgreSQL (PGlite) in data/pgdata,
# which is fine for a single machine but not for serverless hosting.
DATABASE_URL=
# PGLITE_DIR=./data/pgdata

# --- Document storage -------------------------------------------------------------------
# local (default, under ./data) or s3 (any S3-compatible bucket; required on serverless hosts)
STORAGE_DRIVER=local
# STORAGE_DIR=./data
# S3_BUCKET=
# S3_REGION=ap-south-1
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false

# --- Processing ---------------------------------------------------------------------------
# inline: the web server runs the job worker. external: this instance only enqueues; run another
# instance with WORKER_MODE=inline to process jobs.
WORKER_MODE=inline
# auto: Tesseract + Gemini when GEMINI_API_KEY is set; tesseract: keep documents on this server
OCR_ENGINE=auto
# Google AI Studio API key (starts with "AIza"). Needed for handwriting and higher-accuracy extraction.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional RealESRGAN/PaddleOCR service (services/member2-image), local storage only
# MEMBER2_IMAGE_API_URL=http://localhost:8001

# --- Accounts ---------------------------------------------------------------------------
# Training accounts (admin@dharohar.gov / admin123 …). Default: on in development, off in production.
# SEED_DEMO_USERS=false
# NEXT_PUBLIC_SHOW_DEMO_LOGINS=false
# First administrator for an empty production database
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=

# --- Public URL, maps, notifications ---------------------------------------------------------
APP_URL=http://localhost:3000
# none | nominatim (OpenStreetMap geocoding of villages missing from master data)
GEOCODER=none
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Dharohar <no-reply@example.gov.in>
# SMS gateway adapter: receives POST {"to","message"}
# SMS_WEBHOOK_URL=
