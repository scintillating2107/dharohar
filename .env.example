# Dharohar Environment Configuration

# API base URL (defaults to /api for same-origin Next.js API routes)
NEXT_PUBLIC_API_URL=/api

# Mock mode — set to true only for demo/fallback with fake data
NEXT_PUBLIC_USE_MOCK_DATA=false

# JWT secret for authentication (change in production!)
JWT_SECRET=dharohar-dev-secret-change-in-production

# Member 3 & 4 — Gemini OCR + field extraction (when external URLs are not set)
GEMINI_API_KEY=

# Optional: external team member service URLs (overrides built-in local pipeline)
# Leave unset for local pipeline (no Member 2 server required). If set but service is down, app falls back to local processing.
# MEMBER2_IMAGE_API_URL=http://localhost:8001
# MEMBER3_OCR_API_URL=http://localhost:8002
# MEMBER4_EXTRACTION_API_URL=http://localhost:8003
# MEMBER5_VALIDATION_API_URL=http://localhost:8004
# Member 6 — services/member6-database (uvicorn app.main:app --port 8005)
MEMBER6_DATABASE_API_URL=http://localhost:8005
# INTEGRATION_SERVICE_KEY=dharohar-local-dev-key
